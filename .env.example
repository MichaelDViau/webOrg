# Public URL of the site, used for canonical URLs, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact form delivery (https://resend.com). Required in production.
RESEND_API_KEY=
# Inbox that receives project requests.
CONTACT_TO_EMAIL=
# Verified sender address, e.g. "Michael <website@example.com>".
CONTACT_FROM_EMAIL=

# AI assistant (https://console.anthropic.com). The chat widget only appears when this is set.
ANTHROPIC_API_KEY=

# Free website check (https://developers.google.com/speed/docs/insights/v5/get-started).
# Without a key, Google's shared quota is often exhausted, so set this in production.
PAGESPEED_API_KEY=

# Public scheduling link for free consultations, e.g. https://cal.com/your-name/30min
# or https://calendly.com/your-name/30min. Enables the /book page.
NEXT_PUBLIC_BOOKING_URL=
