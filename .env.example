# Public URL of the site, used for canonical URLs, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Email (https://resend.com). Required in production. The sending domain needs SPF, DKIM and DMARC.
RESEND_API_KEY=
# Inbox that receives new requests. A person replies from here within one business hour.
CONTACT_TO_EMAIL=
# Verified sender of the instant confirmation, e.g. "Michael <website@example.com>".
CONTACT_FROM_EMAIL=

# HubSpot (Forms API). Create four forms in HubSpot, one per action, and route each with a workflow.
# The portal ID is in HubSpot under Settings > Account Management. Each form GUID is in the form's URL.
# Field names the site sends: email, firstname, lastname, jobtitle, company, website, phone, message, hs_language.
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_AUDIT=
HUBSPOT_FORM_SNAPSHOT=
HUBSPOT_FORM_CONTACT=
HUBSPOT_FORM_NEWSLETTER=

# Public scheduling link for discovery calls, e.g. https://cal.com/your-name/30min
# or https://calendly.com/your-name/30min. Enables the /book page.
NEXT_PUBLIC_BOOKING_URL=

# Privacy-friendly analytics (https://plausible.io): no cookies, no consent banner needed.
# Set your site's domain to turn it on. Events: audit_request, snapshot_request, contact_request,
# newsletter_signup, each with the page and language. Self-hosted? Also set NEXT_PUBLIC_PLAUSIBLE_SRC.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=

# Google Search Console verification token (the content of the google-site-verification meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# AI assistant (https://console.anthropic.com). The chat widget only appears when this is set.
ANTHROPIC_API_KEY=

# Instant speed check (https://developers.google.com/speed/docs/insights/v5/get-started).
# Without a key, Google's shared quota is often exhausted, so set this in production.
PAGESPEED_API_KEY=
