# Public URL of the site, used for canonical URLs, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact form delivery (https://resend.com). Required in production.
RESEND_API_KEY=
# Inbox that receives project requests.
CONTACT_TO_EMAIL=
# Verified sender address, e.g. "Michael <website@example.com>".
CONTACT_FROM_EMAIL=
